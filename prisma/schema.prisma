// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Brand {
  ERREA
  SOLO
}

enum TipoOrdine {
  ORDINE
  RIASSORTIMENTO
}

enum StatoConsegna {
  DA_ORDINARE
  ORDINATO
  IN_LAVORAZIONE
  IN_CONSEGNA
  CONSEGNATO
  ANNULLATO
}

enum TipoLavorazione {
  STAMPA
  RICAMO
  ALTRO
}

enum StatoLavorazione {
  DA_FARE
  IN_CORSO
  COMPLETATA
}

enum TipoDocumento {
  DDT
  FATTURA
  CONTRATTO
  ALTRO
}

enum KitStato {
  SCELTA_PRODOTTI
  PROVE
  ORDINATO
  IN_LAVORAZIONE
  DA_CONTATTARE
  CONTATTATO
  CHIUSO
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  referente String?
  telefono  String?
  email     String?
  indirizzo String?
  piva      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordini     Ordine[]
  documenti  Documento[]
  kit        Kit[]
}

model Ordine {
  id     String @id @default(cuid())
  numero String?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  brand Brand
  tipo  TipoOrdine @default(ORDINE)

  descrizione   String?
  importoTotale Float

  dataOrdine            DateTime  @default(now())
  dataConsegnaPrevista  DateTime?
  dataConsegnaEffettiva DateTime?

  statoConsegna StatoConsegna @default(DA_ORDINARE)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lavorazioni Lavorazione[]
  pagamenti   Pagamento[]
  documenti   Documento[]
  kit         Kit?
}

model Lavorazione {
  id String @id @default(cuid())

  ordineId String
  ordine   Ordine @relation(fields: [ordineId], references: [id], onDelete: Cascade)

  tipo        TipoLavorazione
  descrizione String?
  fornitore   String?
  costo       Float
  stato       StatoLavorazione @default(DA_FARE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pagamento {
  id String @id @default(cuid())

  ordineId String
  ordine   Ordine @relation(fields: [ordineId], references: [id], onDelete: Cascade)

  data    DateTime @default(now())
  importo Float
  metodo  String?
  note    String?

  createdAt DateTime @default(now())
}

model Documento {
  id String @id @default(cuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  ordineId String?
  ordine   Ordine? @relation(fields: [ordineId], references: [id], onDelete: SetNull)

  tipo     TipoDocumento @default(DDT)
  nome     String
  filePath String
  mimeType String
  size     Int

  createdAt DateTime @default(now())
}

model Kit {
  id String @id @default(cuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome  String
  brand Brand
  stato KitStato @default(SCELTA_PRODOTTI)
  note  String?

  ordineId String? @unique
  ordine   Ordine? @relation(fields: [ordineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodotti KitProdotto[]
  atleti   KitAtleta[]
}

model KitProdotto {
  id String @id @default(cuid())

  kitId String
  kit   Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  nome           String
  prezzoUnitario Float
  note           String?

  createdAt DateTime @default(now())

  taglie KitTaglia[]
}

model KitAtleta {
  id String @id @default(cuid())

  kitId String
  kit   Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  nome      String
  email     String?
  cellulare String?
  note      String?

  createdAt DateTime @default(now())

  taglie KitTaglia[]
}

model KitTaglia {
  id String @id @default(cuid())

  kitAtletaId String
  kitAtleta   KitAtleta @relation(fields: [kitAtletaId], references: [id], onDelete: Cascade)

  kitProdottoId String
  kitProdotto   KitProdotto @relation(fields: [kitProdottoId], references: [id], onDelete: Cascade)

  taglia String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kitAtletaId, kitProdottoId])
}
